# Token issued by @BotFather
BOT_TOKEN=

# Numeric id of the support group (negative number). The group must be a
# supergroup with Topics enabled, and the bot must be an admin there.
STAFF_GROUP_ID=

# Public HTTPS URL of the deployed Vercel app, without a trailing slash.
# Required only for npm run set-webhook.
WEBHOOK_URL=https://your-project.vercel.app

# Random string used to authenticate webhook requests from Telegram.
# Required for Vercel deployment and npm run set-webhook.
WEBHOOK_SECRET=

# Branding (optional). Project name shown in the welcome message and bot profile.
# BRAND_NAME=Acme Finance

# Ticket topics (optional): items separated by ";", each "English | Russian"
# or one label for both languages. Up to 8. Defaults to Deposit, Withdrawal,
# Bug report, Other.
# CATEGORIES=💰 Deposit | 💰 Депозит; 💸 Withdrawal | 💸 Вывод; ❓ Other | ❓ Другое

# Language of messages in the support group: en (default) or ru.
# STAFF_LANG=ru

# Safety line under the welcome message (optional). Unset: the default crypto
# anti-scam text. "off": no line. Otherwise "English | Russian" or one text.
# SCAM_NOTICE=We never ask for your card details | Мы никогда не просим данные карты

# Storage. If both Upstash variables are set, tickets are stored in Upstash
# Redis (required on Vercel: its filesystem is ephemeral). Otherwise a local
# JSON file is used (fine for long polling on a VPS or your own machine).
# UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
# UPSTASH_REDIS_REST_TOKEN=
# Redis key for this bot. Give each client bot its own key to share one database.
# STORE_KEY=ticket-bot:store

# Local JSON file path, used only when Upstash is not configured.
# STORE_PATH=data/store.json
